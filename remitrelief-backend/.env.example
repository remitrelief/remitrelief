PORT=4000
NODE_ENV=development

DEMO_MODE=true
STELLAR_NETWORK=TESTNET
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

BACKEND_SIGNER_SECRET=
INTERNAL_API_KEY=
CRON_SECRET=

# Session auth (required in production)
AUTH_SESSION_SECRET=dev-only-remitrelief-session-secret-change-me
AUTH_SESSION_TTL=43200
AUTH_CHALLENGE_TTL=300
AUTH_COOKIE_NAME=remitrelief_sid
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_DOMAIN=remitrelief
AUTH_DEV_BYPASS=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence: json (local/tests only) | prisma|postgres (requires DATABASE_URL)
# Production REQUIRES DATABASE_URL — JSON is not allowed.
STORE_DRIVER=json
# DATABASE_URL=postgresql://remitrelief:remitrelief@localhost:5432/remitrelief?schema=public

ADMIN_PUBLIC_KEYS=
NGO_PUBLIC_KEYS=
RECIPIENT_PUBLIC_KEYS=

# Optional seed wallets (development only — never production keys)
SEED_ADMIN_WALLET=
SEED_DONOR_WALLET=
SEED_RECIPIENT_WALLET=
SEED_NGO_WALLET=

DEMO_ESCROW_CONTRACT_ID=
# Optional SAC / USDC contract id stored as campaign.usdcIssuer on escrow bind
USDC_CONTRACT_ID=
ALLOW_STORE_RESET=false
LOG_LEVEL=info
