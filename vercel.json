{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && cd remitrelief-frontend && npm install",
  "buildCommand": "cd remitrelief-frontend && npm run build",
  "outputDirectory": "remitrelief-frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/internal/indexer/run",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "remitrelief-backend/**"
    }
  }
}
